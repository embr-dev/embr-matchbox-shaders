    Description="Morphological filter. Square, Line, or Circle (square+diamond octagon). RGB or Luma. Dilate/Erode or Open/Close; Size sign selects the direction; Angle rotates the kernel. Strength scales Size per pixel; Mix blends with the original."
    Name="Embr Morphology">
  <Shader OutputBitDepth="Output" Index="1">
    <Uniform Index="0" NoInput="Error" DisplayName="Front" InputType="Front"
             Mipmaps="False"
