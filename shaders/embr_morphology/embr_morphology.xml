      <PopupEntry Title="Line" Value="1"/>
    </Uniform>
    <Uniform Max="1" Min="0" Default="1" Inc="1" Row="2" Col="0" Page="0"
             Type="int" ChannelName="mode" DisplayName="Mode" Name="mode" ValueType="Popup">
      <PopupEntry Title="Open / Close" Value="1"/>
      <PopupEntry Title="Dilate / Erode" Value="0"/>
    </Uniform>
    <Uniform Max="256" Min="-256" Default="0" Inc="1"
             Tooltip="Radius in pixels. Dilate/Erode: + dilate, - erode. Open/Close: + close, - open. 0 is a no-op."
             Row="0" Col="1" Page="0" Type="int" ChannelName="size" DisplayName="Size" Name="size">
    </Uniform>
    <Uniform ResDependent="None" Max="360.0" Min="-360.0" Default="0.0" Inc="1.0"
             Tooltip="Kernel rotation in degrees. Square period 90. Circle period 45. Line: 0 is horizontal, 90 is vertical, period 180."
             Row="1" Col="1" Page="0" Type="float" ChannelName="angle" DisplayName="Angle" Name="angle">
    </Uniform>
    <Uniform ResDependent="None" Max="1.0" Min="0.0" Default="1.0" Inc="0.01"
             Tooltip="Blend with original Front. 0 is original, 1 is full effect."
             Row="2" Col="1" Page="0" Type="float" ChannelName="mix_amount" DisplayName="Mix" Name="mix_amount">
    </Uniform>
  </Shader>
