             GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE" GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
             GL_TEXTURE_MAG_FILTER="GL_LINEAR" GL_TEXTURE_MIN_FILTER="GL_LINEAR"
             Type="sampler2D" Name="strength">
    </Uniform>
    <Uniform Max="1" Min="0" Default="0" Inc="1" Row="0" Col="0" Page="0"
             Tooltip="RGB: per-channel min/max. Luma: morph adsk_getLuminance, keep chromaticity."
             Type="int" ChannelName="channel" DisplayName="Channel" Name="channel" ValueType="Popup">
      <PopupEntry Title="RGB" Value="0"/>
      <PopupEntry Title="Luma" Value="1"/>
    </Uniform>
    <Uniform Max="2" Min="0" Default="2" Inc="1" Row="1" Col="0" Page="0"
